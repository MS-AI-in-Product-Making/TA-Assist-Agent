{
  "name": "ai-assist-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "npm run build -- --force && vitest run --workspace vitest.workspace.ts",
    "check:repository": "node scripts/verify-repository.mjs",
    "verify:f4-excel-regression": "pwsh -NoProfile -File scripts/verify-f4-excel-regression.ps1",
    "export:dual-md": "pwsh -NoProfile -File scripts/export-excel-dual-grid.ps1",
    "export:dual-md:lite": "pwsh -NoProfile -File scripts/export-excel-dual-grid.ps1 -OutputDir test/demo-output/full-tables-md-lite",
    "demo:task1.5": "node scripts/run-f1-task1-5-demo.mjs",
    "demo:task1.6": "node scripts/run-f1-task1-6-demo.mjs",
    "demo:task1.7": "node scripts/run-f1-task1-7-demo.mjs",
    "workflow:f1": "node scripts/run-f1-full-validation.mjs",
    "workflow:f2": "node scripts/run-f2-full-validation.mjs",
    "workflow:f2:excel": "node scripts/f2-excel-runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
