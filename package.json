{
  "name": "ai-assist-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:beta": "npm --workspace @ai-assist/vscode-extension run build:beta",
    "package:vsix": "npm --workspace @ai-assist/vscode-extension run package:vsix",
    "dev:f7": "concurrently --kill-others-on-fail --names api,web \"npm run dev:f7:api\" \"npm run dev:f7:web\"",
    "dev:f7:api": "npm run dev --workspace @ai-assist/f7-local-api",
    "dev:f7:web": "npm run dev --workspace @ai-assist/f7-web",
    "build:f7:web": "npm run build --workspace @ai-assist/f7-web",
    "lint": "eslint .",
    "test": "npm run build -- --force && vitest run",
    "test:e2e": "playwright test",
    "check:repository": "node scripts/verify-repository.mjs",
    "verify:f4-excel-regression": "pwsh -NoProfile -File scripts/verify-f4-excel-regression.ps1",
    "export:dual-md": "pwsh -NoProfile -File scripts/export-excel-dual-grid.ps1",
    "export:dual-md:lite": "pwsh -NoProfile -File scripts/export-excel-dual-grid.ps1 -OutputDir test/demo-output/full-tables-md-lite",
    "demo:task1.5": "node scripts/run-f1-task1-5-demo.mjs",
    "demo:task1.6": "node scripts/run-f1-task1-6-demo.mjs",
    "demo:task1.7": "node scripts/run-f1-task1-7-demo.mjs",
    "workflow:f1": "node scripts/run-f1-full-validation.mjs",
    "workflow:f2": "node scripts/run-f2-full-validation.mjs",
    "workflow:f2:excel": "node scripts/f2-excel-runner.mjs",
    "workflow:f3": "node scripts/run-f3-full-validation.mjs",
    "workflow:f3:ado-reminder": "node scripts/write-f3-ado-reminder.mjs",
    "workflow:f4": "node scripts/run-f4-full-validation.mjs",
    "workflow:f5": "node scripts/run-f5-full-validation.mjs",
    "workflow:f6": "node scripts/run-f6-full-validation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.0.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
