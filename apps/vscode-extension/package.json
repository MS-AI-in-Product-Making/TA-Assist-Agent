{
  "name": "ta-assist-agent",
  "private": true,
  "version": "0.1.0",
  "publisher": "ai-assist",
  "displayName": "TA Assist Agent",
  "description": "Run, resume, and inspect governed tolerance analysis.",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b",
    "build:beta": "node ./scripts/build.mjs",
    "package:vsix": "node ./scripts/package-vsix.mjs",
    "test": "vitest run --workspace ../../vitest.workspace.ts src"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "activationEvents": [
    "onChatParticipant:ta-assist"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ta-assist.analyze",
        "title": "TA Assist Agent: Analyze Workbook"
      },
      {
        "command": "ta-assist.resume",
        "title": "TA Assist Agent: Resume Session"
      },
      {
        "command": "ta-assist.workbench",
        "title": "TA Assist Agent: Open Workbench"
      },
      {
        "command": "ta-assist.openKnowledgeLibrary",
        "title": "TA Assist Agent: Open Knowledge Library"
      },
      {
        "command": "ta-assist.openRealMeasurementAnalysis",
        "title": "TA Assist Agent: Open Real-Measurement Analysis"
      },
      {
        "command": "ta-assist.openSessionRecord",
        "title": "TA Assist Agent: Open Session Record"
      },
      {
        "command": "ta-assist.executeHostAction",
        "title": "TA Assist Agent: Execute Surface Host Action"
      }
    ],
    "chatParticipants": [
      {
        "id": "ta-assist",
        "name": "ta-assist",
        "fullName": "TA Assist Agent",
        "description": "Run, resume, and inspect governed tolerance analysis.",
        "commands": [
          {
            "name": "analyze",
            "description": "Start TA analysis"
          },
          {
            "name": "resume",
            "description": "Resume a TA session"
          },
          {
            "name": "workbench",
            "description": "Open the TA Workbench"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@ai-assist/adapters": "0.1.0",
    "@ai-assist/agent-runtime": "0.1.0",
    "@ai-assist/contracts": "0.1.0",
    "@ai-assist/conversation": "0.1.0",
    "@ai-assist/product-language": "0.1.0",
    "@ai-assist/workbench": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "3.9.2"
  }
}
