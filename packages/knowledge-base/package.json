{
  "name": "@ai-assist/knowledge-base",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck:type-tests": "tsc -p tsconfig.type-tests.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
